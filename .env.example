# ============================================================
# Edu Hierarchical Classifier 本机运行配置模板
# 复制为 .env 后按需修改；所有字段都有默认值，前缀 EDU_
# Docker Compose 模式不用本文件（compose 内使用 .env.compose 注入同名变量）
# ============================================================

# ---------- 应用 ----------
EDU_API_HOST=127.0.0.1
EDU_API_PORT=7860
# CORS 白名单（逗号分隔，禁止 *）
EDU_CORS_ALLOW_ORIGINS=http://127.0.0.1:7860,http://localhost:7860
EDU_RATE_LIMIT_PER_MINUTE=120

# ---------- 认证与权限（改进计划 WP-D；生产必须启用鉴权） ----------
# JWT 签名密钥：鉴权开启时必须 ≥16 字符且非本示例值（preflight 强校验，生产请用随机长串）
EDU_JWT_SECRET=change-me-to-a-long-random-string
# token 有效期（分钟）
EDU_TOKEN_EXPIRE_MINUTES=480
# 首次启动且 users 表为空时自动创建 admin 账号的初始密码（创建后可移除该行）
EDU_ADMIN_BOOTSTRAP_PASSWORD=
# 仅限本机开发调试临时关闭鉴权；生产必须 false
EDU_AUTH_DISABLED=false

# ---------- 路径（相对项目根，一般无需修改） ----------
EDU_DATA_PROCESSED_DIR=data/processed
EDU_BACKBONE_DIR=models/pretrained_backbone/bert-base-chinese
EDU_MODEL_VERSIONS_DIR=models/versions

# ---------- 模型 ----------
EDU_MAX_SEQ_LENGTH=256
EDU_FREEZE_RATIO=0.75
EDU_USE_DYNAMIC_QUANTIZATION=true
EDU_PREDICT_CACHE_SIZE=512
# 知识点学科 mask（WP-G1）：按预测学科屏蔽非法知识点。实测默认关闭（连坐效应），
# 学科感知增强（WP-G2）落地后可重测开启
EDU_KNOWLEDGE_MASK_ENABLED=false

# ---------- 分类接口 ----------
EDU_CLASSIFY_MAX_CHARS=4000
EDU_CONFIDENCE_HIGH=0.80
EDU_CONFIDENCE_MEDIUM=0.60

# ---------- MySQL（业务主库；本机模式可复用 knowforge 的 MySQL 容器，只需新建库） ----------
EDU_MYSQL_HOST=127.0.0.1
EDU_MYSQL_PORT=3306
EDU_MYSQL_USER=root
EDU_MYSQL_PASSWORD=root123
EDU_MYSQL_DB=edu_classifier

# ---------- Milvus（题目语义查重；不可用时查重功能自动跳过，不影响主链路） ----------
EDU_MILVUS_ENABLED=true
EDU_MILVUS_URI=http://127.0.0.1:19530
EDU_MILVUS_COLLECTION=edu_question_dedup
EDU_DEDUP_SIMILARITY_THRESHOLD=0.95

# ---------- R3.3 推荐语义召回（增强，默认关闭；启用前先执行 scripts/backfill_question_vectors.py 回填向量） ----------
EDU_RECOMMEND_SEMANTIC_ENABLED=false
EDU_RECOMMEND_SEMANTIC_SEEDS=3
EDU_RECOMMEND_SEMANTIC_TOP_K=12
EDU_RECOMMEND_SEMANTIC_LOW=0.55
EDU_RECOMMEND_SEMANTIC_HIGH=0.95
EDU_RECOMMEND_SEMANTIC_WEIGHT=0.12

# ---------- RAG 教育知识库（R1；默认关闭，密钥只写本机 .env） ----------
EDU_RAG_ENABLED=false
EDU_RAG_UPLOAD_DIR=data/rag_uploads
EDU_RAG_DOCUMENTS_COLLECTION=edu_rag_documents
EDU_RAG_QUESTIONS_COLLECTION=edu_rag_questions
EDU_RAG_FAQ_COLLECTION=edu_rag_faq
EDU_RAG_EMBEDDING_PROVIDER=openai_compatible
EDU_RAG_EMBEDDING_BASE_URL=
EDU_RAG_EMBEDDING_API_KEY=
EDU_RAG_EMBEDDING_MODEL=
EDU_RAG_EMBEDDING_DIMENSION=1024
EDU_RAG_RERANKER_PROVIDER=disabled
EDU_RAG_RERANKER_BASE_URL=
EDU_RAG_RERANKER_API_KEY=
EDU_RAG_RERANKER_MODEL=
# cohere_compatible: base_url 为 /rerank 之前的前缀；不得误用聊天端点。
# 启用前必须配置独立证据阈值，以下留空表示尚未校准。
# EDU_RAG_RERANKER_MIN_SCORE=填写经评测确定的0到1数值
EDU_RAG_RERANKER_MAX_CANDIDATES=24
EDU_RAG_LLM_PROVIDER=openai_compatible
# 原生模型流默认为关闭；开启前验证服务支持 delta/stop/[DONE] 协议。
EDU_RAG_NATIVE_STREAM_ENABLED=false
# 启用后生成答案经模型核验，最多一次重写；流式正文须等待核验完成。
EDU_RAG_GROUNDING_CHECK_ENABLED=false
# 保守追问主题记忆；仅使用最近已完成轮次的用户问题，旧答案不作为证据。
EDU_RAG_CONVERSATION_MEMORY_ENABLED=false
# 本地扫描 PDF OCR：需要 Poppler、Tesseract 与 chi_sim/eng 语言包。
EDU_RAG_OCR_ENABLED=false
# native（默认）或 tesseract_js；后者需本地 Node、模块与已下载的语言包。
EDU_RAG_OCR_BACKEND=native
# page 或 lines_tables；后者仅限 JS 后端，需 sharp，适合横排单栏及简单有框表格。
EDU_RAG_OCR_LAYOUT_MODE=page
EDU_RAG_OCR_NODE_COMMAND=node
EDU_RAG_OCR_JS_MODULE_DIR=
EDU_RAG_OCR_TESSDATA_DIR=
EDU_RAG_OCR_PDFTOPPM_COMMAND=pdftoppm
EDU_RAG_OCR_TESSERACT_COMMAND=tesseract
EDU_RAG_OCR_LANGUAGES=chi_sim+eng
EDU_RAG_OCR_MIN_TEXT_CHARS=20
EDU_RAG_OCR_MAX_PAGES=20
EDU_RAG_OCR_MAX_SIDE_PIXELS=3000
EDU_RAG_OCR_TIMEOUT_SECONDS=60
EDU_RAG_LLM_BASE_URL=
EDU_RAG_LLM_API_KEY=
EDU_RAG_LLM_MODEL=
EDU_RAG_TOP_K=12
# 小规模授权语料 BM25+RRF，默认关闭；排序分不替代证据阈值。
EDU_RAG_HYBRID_ENABLED=false
EDU_RAG_BM25_MAX_CHUNKS=5000
EDU_RAG_RRF_K=60
EDU_RAG_RERANK_TOP_K=5
EDU_RAG_MIN_EVIDENCE_SCORE=0.55
EDU_RAG_MAX_CONTEXT_CHARS=6000
EDU_RAG_PARENT_CHUNK_CHARS=1000
EDU_RAG_CHILD_CHUNK_CHARS=350
EDU_RAG_CHUNK_OVERLAP_CHARS=60
EDU_RAG_REQUEST_TIMEOUT_SECONDS=30
EDU_RAG_MAX_UPLOAD_BYTES=26214400
EDU_RAG_MAX_DOCUMENTS_PER_TEACHER=200
EDU_RAG_INGESTION_MAX_ATTEMPTS=3

# ---------- 评测与质量门禁 ----------
EDU_GOLDEN_SET_SIZE=300
EDU_GATE_MIN_SUBJECT_ACC=0.85
EDU_GATE_MIN_TYPE_F1=0.85
EDU_GATE_MIN_KNOWLEDGE_F1=0.40
EDU_GATE_MIN_CASCADE_ACC=0.65
EDU_GATE_MAX_LATENCY_MS=1500
