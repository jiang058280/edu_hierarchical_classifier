# ============================================================
# Edu Hierarchical Classifier 本机运行配置模板
# 复制为 .env 后按需修改；所有字段都有默认值，前缀 EDU_
# Docker Compose 模式不用本文件（compose 内使用 .env.compose 注入同名变量）
# ============================================================

# ---------- 应用 ----------
EDU_API_HOST=127.0.0.1
EDU_API_PORT=7860
# CORS 白名单（逗号分隔，禁止 *）
EDU_CORS_ALLOW_ORIGINS=http://127.0.0.1:7860,http://localhost:7860
EDU_RATE_LIMIT_PER_MINUTE=120

# ---------- 路径（相对项目根，一般无需修改） ----------
EDU_DATA_PROCESSED_DIR=data/processed
EDU_BACKBONE_DIR=models/pretrained_backbone/bert-base-chinese
EDU_MODEL_VERSIONS_DIR=models/versions

# ---------- 模型 ----------
EDU_MAX_SEQ_LENGTH=256
EDU_FREEZE_RATIO=0.75
EDU_USE_DYNAMIC_QUANTIZATION=true
EDU_PREDICT_CACHE_SIZE=512

# ---------- 分类接口 ----------
EDU_CLASSIFY_MAX_CHARS=4000
EDU_CONFIDENCE_HIGH=0.80
EDU_CONFIDENCE_MEDIUM=0.60

# ---------- MySQL（业务主库；本机模式可复用 knowforge 的 MySQL 容器，只需新建库） ----------
EDU_MYSQL_HOST=127.0.0.1
EDU_MYSQL_PORT=3306
EDU_MYSQL_USER=root
EDU_MYSQL_PASSWORD=root123
EDU_MYSQL_DB=edu_classifier

# ---------- Milvus（题目语义查重；不可用时查重功能自动跳过，不影响主链路） ----------
EDU_MILVUS_ENABLED=true
EDU_MILVUS_URI=http://127.0.0.1:19530
EDU_MILVUS_COLLECTION=edu_question_dedup
EDU_DEDUP_SIMILARITY_THRESHOLD=0.95

# ---------- 评测与质量门禁 ----------
EDU_GOLDEN_SET_SIZE=300
EDU_GATE_MIN_SUBJECT_ACC=0.85
EDU_GATE_MIN_TYPE_F1=0.85
EDU_GATE_MIN_KNOWLEDGE_F1=0.40
EDU_GATE_MIN_CASCADE_ACC=0.65
EDU_GATE_MAX_LATENCY_MS=1500
